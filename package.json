{
  "commitlint": {
    "rules": {
      "description": "max 50 chars, imperative, no period",
      "format": "<type>(<scope>): <description>",
      "scope": "optional, kebab-case (e.g. auth, gallery, routing)",
      "types": "feat | fix | docs | style | refactor | test | chore | perf | ci | build | revert"
    }
  },
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@jsverse/transloco": "^8.2.1",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/node": "^26.6.2",
    "@vitest/ui": "^4.1.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.0.3",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.1",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.3"
  },
  "name": "framed-by-santi",
  "private": true,
  "scripts": {
    "build": "vite build",
    "commit:validate": "node -e \"const msg = process.argv[1]; const ok = /^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\\(.+\\))?: .{1,50}$/.test(msg); process.exit(ok ? 0 : 1);\" --",
    "dev": "vite --mode dev --open",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"*.json\"",
    "lint": "eslint \"src/**/*.{ts,html}\" && eslint \"*.json\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix && eslint \"*.json\" --fix",
    "ng": "ng",
    "preview": "vite preview",
    "start": "vite --mode dev --open",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "watch": "vite build --watch"
  },
  "type": "module",
  "version": "0.0.0"
}
